{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "admin-portal": {
      "root": "apps/admin-portal",
      "framework": "nextjs"
    },
    "attendance": {
      "root": "apps/attendance",
      "framework": "nextjs"
    },
    "calls-incidents": {
      "root": "apps/calls-incidents",
      "framework": "nextjs"
    },
    "oriana": {
      "root": "apps/oriana",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    { "source": "/asistencia", "destination": { "service": "admin-portal" } },
    { "source": "/asistencia/(.*)", "destination": { "service": "admin-portal" } },
    { "source": "/oriana", "destination": { "service": "oriana" } },
    { "source": "/oriana/(.*)", "destination": { "service": "oriana" } },
    { "source": "/llamadas", "destination": { "service": "calls-incidents" } },
    { "source": "/llamadas/(.*)", "destination": { "service": "calls-incidents" } },
    { "source": "/admin", "destination": { "service": "admin-portal" } },
    { "source": "/admin/(.*)", "destination": { "service": "admin-portal" } },
    { "source": "/(.*)", "destination": { "service": "admin-portal" } }
  ]
}
